# Backend application environment example.
# Copy this file to `apps/backend/.env` for local development.

# Application
APP_NAME=JaubiChatBackend
NODE_ENV=local

# Public backend URL.
APP_URL=http://localhost:4001

# Public web frontend URL used for links such as email verification.
FRONTEND_URL=http://localhost:4002

# HTTP server
BACKEND_PORT=4001
GLOBAL_PREFIX=api

# Allowed browser origin for local CORS requests.
BACKEND_CORS_ORIGIN=http://localhost:4002

# Database
DATABASE_URL=mysql://jaubi_chat:jaubi_chat@localhost:23306/jaubi_chat

# Development-only shadow database used by `prisma migrate dev`.
SHADOW_DATABASE_URL=mysql://jaubi_chat:jaubi_chat@localhost:23306/jaubi_chat_shadow

# JWT
# Generate unique local secrets with `pnpm jwt:generate`.
JWT_ACCESS_SECRET=local-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=local-refresh-secret-at-least-32-characters
