# Local Docker Compose environment example.
# Copy this file to `.env` in the repository root to override defaults.

# MariaDB container
# Host port exposed by the container. MariaDB listens on 3306 internally.
MARIADB_PORT=23306
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=jaubi_chat
MARIADB_USER=jaubi_chat
MARIADB_PASSWORD=jaubi_chat

# Connection string for local database tools.
# The backend application uses `apps/backend/.env`.
DATABASE_URL=mysql://jaubi_chat:jaubi_chat@localhost:23306/jaubi_chat
