meta {
  name: 회원가입-신규사용자
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "email": "{{testEmail}}",
    "displayName": "홍길동",
    "password": "password"
  }
}

script:pre-request {
  bru.setVar("testEmail", `user-${Date.now()}@example.com`);
}

settings {
  encodeUrl: true
  timeout: 0
}
